<%@ page pageEncoding="UTF-8" %>
<nav class="pagination" aria-label="Phân trang">
  <p>Trang <%=q.page()%></p>
  <div class="pagination-btns">
    <% if(q.page()>1){ %><button class="btn btn-sm" form="filters" name="page" value="<%=q.page()-1%>">← Trang trước</button><% } %>
    <% if(d.hasNext()){ %><button class="btn btn-sm" form="filters" name="page" value="<%=q.page()+1%>">Trang sau →</button><% } %>
  </div>
</nav>
