<%@ page pageEncoding="UTF-8" %>
<nav aria-label="Phân trang"><p>Trang <%=q.page()%></p>
<% if(q.page()>1){ %><button form="filters" name="page" value="<%=q.page()-1%>">Trang trước</button><% } %>
<% if(d.hasNext()){ %><button form="filters" name="page" value="<%=q.page()+1%>">Trang sau</button><% } %></nav>
