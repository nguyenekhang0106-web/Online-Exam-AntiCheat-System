<%@ page pageEncoding="UTF-8" %>
<div class="stack-form" style="max-width:100%">
  <div class="form-grid-2">
    <label>Tên đề *
      <input name="title" required maxlength="200" placeholder="Ví dụ: Kiểm tra giữa kỳ Web" value="<%=escape(e.getOrDefault("title",""))%>">
    </label>
    <label>Mẫu quy định thi
      <select name="policy">
        <option value="">Không áp dụng mẫu</option>
        <% Object currentPolicy=e.get("policy_id"); var policies=(List<Map<String,Object>>)request.getAttribute("policies");
        if(currentPolicy!=null && policies.stream().noneMatch(row->currentPolicy.equals(row.get("id")))){ %><option selected value="<%=currentPolicy%>">Giữ mẫu hiện tại #<%=currentPolicy%></option><% }
        for(var policy:policies){ %><option value="<%=policy.get("id")%>" <%=Objects.equals(currentPolicy,policy.get("id"))?"selected":""%>><%=escape(policy.get("policy_name"))%></option><% } %>
      </select>
    </label>
  </div>

  <div class="form-grid-2">
    <label>Cách chọn câu hỏi
      <select name="mode">
        <option value="FIXED">Cố định</option>
        <option value="RANDOM_PER_ATTEMPT" <%="RANDOM_PER_ATTEMPT".equals(e.get("selection_mode"))?"selected":""%>>Ngẫu nhiên mỗi lượt</option>
      </select>
    </label>
    <label>Số câu cần rút (để trống nếu cố định)
      <input type="number" min="1" name="count" value="<%=escape(Objects.toString(e.get("question_count"),""))%>">
    </label>
  </div>

  <div class="form-grid-2" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
    <label>Thời lượng (phút) *
      <input name="duration" type="number" required min="1" max="32767" value="<%=e.getOrDefault("duration_minutes",45)%>">
    </label>
    <label>Số lượt tối đa *
      <input name="attempts" type="number" required min="1" max="32767" value="<%=e.getOrDefault("max_attempts",1)%>">
    </label>
    <label>Điểm đạt (%) *
      <input name="pass" type="number" required min="0" max="100" step=".01" value="<%=e.getOrDefault("pass_percentage",50)%>">
    </label>
  </div>

  <label>Hướng dẫn
    <textarea name="instructions" rows="3" placeholder="Nhập hướng dẫn làm bài cho thí sinh…"><%=escape(Objects.toString(e.get("instructions"),""))%></textarea>
  </label>

  <div class="form-actions" style="padding-top:0">
    <label class="check-label"><input type="checkbox" name="shuffleQuestions" <%=Set.of("true","1").contains(String.valueOf(e.get("shuffle_questions")))?"checked":""%>> <span>Trộn câu hỏi</span></label>
    <label class="check-label"><input type="checkbox" name="shuffleOptions" <%=Set.of("true","1").contains(String.valueOf(e.get("shuffle_options")))?"checked":""%>> <span>Trộn lựa chọn</span></label>
  </div>

  <div class="form-grid-2" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
    <label>Chọn điểm từ các lượt
      <select name="scorePolicy">
        <% for(String option:List.of("HIGHEST","LATEST","FIRST")){ %><option <%=option.equals(e.get("attempt_score_policy"))?"selected":""%>><%=option%></option><% } %>
      </select>
    </label>
    <label>Công bố kết quả
      <select name="resultRelease">
        <% for(String option:List.of("MANUAL","IMMEDIATE","AFTER_CLOSE")){ %><option <%=option.equals(e.get("result_release_mode"))?"selected":""%>><%=option%></option><% } %>
      </select>
    </label>
    <label>Công bố đáp án
      <select name="answerRelease">
        <% for(String option:List.of("NEVER","AFTER_CLOSE","MANUAL")){ %><option <%=option.equals(e.get("answer_release_mode"))?"selected":""%>><%=option%></option><% } %>
      </select>
    </label>
  </div>
</div>
