<%@ page pageEncoding="UTF-8" %>
<%!
    String uiBadge(Object raw) {
        String v = raw == null ? "" : raw.toString().toUpperCase(java.util.Locale.ROOT);
        switch (v) {
            case "ACTIVE":
            case "PUBLISHED":
            case "ENROLLED":
            case "COMPLETED":
            case "EASY":
            case "OPEN":
            case "SUBMITTED":
                return "badge badge-green";
            case "DRAFT":
            case "MEDIUM":
            case "STUDENT":
            case "UPCOMING":
            case "IN_PROGRESS":
                return "badge badge-pink";
            case "ADMIN":
            case "TEACHER":
            case "SHARED":
            case "RANDOM_PER_ATTEMPT":
            case "HIGHEST":
            case "IMMEDIATE":
                return "badge badge-purple";
            case "LOCKED":
            case "HARD":
            case "EXPIRED":
            case "INVALIDATED":
            case "CANCELLED":
            case "AUTO_SUBMITTED":
                return "badge badge-red";
            default:
                return "badge badge-neutral";
        }
    }
%>
<%
    String uiCtx = request.getContextPath();
    String uiRole = String.valueOf(request.getAttribute("roleLabel"));
    String uiRoleLower = uiRole.toLowerCase(java.util.Locale.ROOT);
    String uiBase = uiCtx + "/" + uiRoleLower;
    String uiPath = String.valueOf(request.getAttribute("jakarta.servlet.forward.servlet_path"));
    if ("null".equals(uiPath)) uiPath = request.getServletPath();
    vn.edu.onlineexam.model.AuthUser uiUser = (vn.edu.onlineexam.model.AuthUser) request.getAttribute("authenticatedUser");
    String uiCrumb = request.getAttribute("pageCrumb") != null ? String.valueOf(request.getAttribute("pageCrumb")) : "Tổng quan";
    boolean uiAdmin = "ADMIN".equals(uiRole);
    boolean uiTeacher = "TEACHER".equals(uiRole);
    boolean uiStudent = "STUDENT".equals(uiRole);
    String uiRoleVi = uiAdmin ? "Quản trị viên" : uiTeacher ? "Giảng viên" : "Sinh viên";
    String uiInitials = uiAdmin ? "AD" : uiTeacher ? "GV" : "SV";
    String uiCtaHref = uiAdmin ? uiBase + "/users/new" : uiTeacher ? uiBase + "/exams" : uiBase + "/schedule";
    String uiCtaLabel = uiAdmin ? "+ Thêm tài khoản" : uiTeacher ? "+ Tạo & Quản lý đề" : "Lịch thi của tôi";
%>
<div class="app-shell">
  <aside class="sidebar" aria-label="Điều hướng chính">
    <div class="sidebar-brand">
      <span class="brand-mark" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L3 7v10l9 5 9-5V7l-9-5z"/><path d="M9 12l2 2 4-4"/></svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Online Exam</span>
        <span class="brand-sub">Cổng thi trực tuyến</span>
      </span>
    </div>
    <div class="sidebar-cta">
      <a class="btn btn-primary" href="<%=uiCtaHref%>"><%=uiCtaLabel%></a>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-group">
        <div class="nav-group-label">Tổng quan</div>
        <a class="nav-link <%=uiPath.endsWith("/account") ? "is-active" : ""%>" href="<%=uiBase%>/account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          <span>Bảng điều khiển</span>
        </a>
        <% if (uiStudent) { %>
        <a class="nav-link <%=uiPath.endsWith("/schedule") ? "is-active" : ""%>" href="<%=uiBase%>/schedule">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span>Lịch thi của tôi</span>
        </a>
        <% } %>
        <a class="nav-link <%=uiPath.endsWith("/attempts") ? "is-active" : ""%>" href="<%=uiBase%>/attempts">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span>Lượt thi &amp; Kết quả</span>
        </a>
      </div>

      <% if (uiAdmin || uiTeacher) { %>
      <div class="nav-group">
        <div class="nav-group-label">Đề &amp; Ngân hàng câu hỏi</div>
        <a class="nav-link <%=uiPath.contains("/exams") ? "is-active" : ""%>" href="<%=uiBase%>/exams">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
          <span>Đề &amp; Phân công thi</span>
        </a>
        <a class="nav-link <%=uiPath.contains("/topics") ? "is-active" : ""%>" href="<%=uiBase%>/topics">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h14"/></svg>
          <span>Chủ đề</span>
        </a>
        <a class="nav-link <%=uiPath.contains("/banks") ? "is-active" : ""%>" href="<%=uiBase%>/banks">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Ngân hàng câu hỏi</span>
        </a>
        <a class="nav-link <%=uiPath.contains("/questions") ? "is-active" : ""%>" href="<%=uiBase%>/questions">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>Câu hỏi</span>
        </a>
      </div>
      <% } %>

      <div class="nav-group">
        <div class="nav-group-label">Đào tạo &amp; Học vụ</div>
        <a class="nav-link <%=uiPath.contains("/subjects") ? "is-active" : ""%>" href="<%=uiBase%>/subjects">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span>Môn học</span>
        </a>
        <a class="nav-link <%=uiPath.contains("/classes") ? "is-active" : ""%>" href="<%=uiBase%>/classes">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Lớp hành chính</span>
        </a>
        <a class="nav-link <%=uiPath.contains("/offerings") ? "is-active" : ""%>" href="<%=uiBase%>/offerings">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span>Lớp học phần</span>
        </a>
        <a class="nav-link <%=uiPath.contains("/enrollments") ? "is-active" : ""%>" href="<%=uiBase%>/enrollments">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          <span>Ghi danh sinh viên</span>
        </a>
      </div>

      <% if (uiAdmin) { %>
      <div class="nav-group">
        <div class="nav-group-label">Quản trị</div>
        <a class="nav-link <%=uiPath.contains("/users") ? "is-active" : ""%>" href="<%=uiBase%>/users">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Quản lý người dùng</span>
        </a>
      </div>
      <% } %>
    </nav>

    <div class="sidebar-footer">
      <div class="user-chip">
        <span class="user-avatar"><%=uiInitials%></span>
        <div class="user-meta">
          <div class="user-name"><%=uiRoleVi%></div>
          <span class="<%=uiBadge(uiRole)%>"><%=uiRoleVi%></span>
        </div>
      </div>
      <form class="logout-form" method="post" action="<%=uiCtx%>/logout">
        <input type="hidden" name="csrf" value="<%=vn.edu.onlineexam.util.Html.escape(session.getAttribute("csrf"))%>">
        <button class="btn btn-sm logout-btn">Đăng xuất</button>
      </form>
    </div>
  </aside>

  <div class="workspace">
    <header class="topbar">
      <div class="topbar-left">
        <button type="button" class="menu-toggle" data-nav-toggle aria-label="Mở menu" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="breadcrumb">
          <a href="<%=uiBase%>/account">Online Exam</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current"><%=vn.edu.onlineexam.util.Html.escape(uiCrumb)%></span>
        </div>
      </div>
      <div class="topbar-right">
        <span class="<%=uiBadge(uiRole)%>"><%=uiRoleVi%></span>
        <a class="btn btn-sm" href="<%=uiBase%>/account">Tài khoản</a>
      </div>
    </header>
    <main class="page-content">
